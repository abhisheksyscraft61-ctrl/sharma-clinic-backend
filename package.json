{
  "name": "cliniccare-backend",
  "version": "1.0.0",
  "description": "Node.js + Express + MySQL backend for the ClinicCare patient management app",
  "main": "src/server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "db:migrate": "mysql -u$DB_USER -p$DB_PASSWORD -h$DB_HOST $DB_NAME < db/schema.sql",
    "db:seed": "mysql -u$DB_USER -p$DB_PASSWORD -h$DB_HOST $DB_NAME < db/seed.sql"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-validator": "^7.1.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.0.0",
    "mysql2": "^3.11.3",
    "serve-favicon": "^2.5.1",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
